SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
# Profiling apagado por defecto (0). Requiere pay-as-you-go en el plan free.
SENTRY_PROFILES_SAMPLE_RATE=0

# Cloudflare R2 (material didactico). Sin estas vars el endpoint /api/material/upload-url
# responde 503 y no se puede subir material nuevo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ccdt-material
# URL publica del bucket: dominio propio o el de r2.dev. Sin barra final.
R2_PUBLIC_URL=
