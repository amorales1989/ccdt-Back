# Config de GlitchTip. Copiar a .env (que esta gitigrado) y completar.

# Imagen. Arranca con :latest para probar; una vez que funcione, fijá la version
# concreta que quedó andando (docker-compose exec web ./manage.py --version, o
# mirá los tags en hub.docker.com/r/glitchtip/glitchtip) para que un pull futuro
# no te cambie la version sin aviso.
GLITCHTIP_IMAGE=glitchtip/glitchtip:latest

# Generar con: openssl rand -base64 48
SECRET_KEY=

# Generar con: openssl rand -hex 24 — hex a proposito: va dentro del DATABASE_URL
# y un / o un + de base64 lo rompen.
POSTGRES_PASSWORD=

# URL publica exacta, con esquema y sin barra final. De acá sale el DSN.
GLITCHTIP_DOMAIN=https://errores.n-xus.com

# Hostnames que acepta, separados por coma y SIN esquema. Si no lo seteás queda
# en '*' (acepta cualquier Host) y GlitchTip te lo avisa en el log de arranque.
ALLOWED_HOSTS=errores.n-xus.com

# Puerto local donde escucha el contenedor web (solo 127.0.0.1).
# 8000 por si choca con algo; el stack local de Supabase usa 54321-54324.
WEB_PORT=8000

# Retencion de eventos en dias.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=60

# Poner true SOLO para crear tu usuario, despues volver a false y recrear (ver README).
ENABLE_USER_REGISTRATION=true

# Email para invitaciones y alertas.
# Para probar sin SMTP: consolemail://  (los mails salen por el log del contenedor)
# Con Resend, que ya usás en el back: smtp://resend:TU_API_KEY@smtp.resend.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=errores@n-xus.com
