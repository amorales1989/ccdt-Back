# Reporte de errores. El DSN sale de GlitchTip self-hosted, no de sentry.io
# (misma API, mismo SDK). Como levantarlo: deploy/glitchtip/README.md
# Sin DSN el SDK queda inactivo y no rompe nada.
SENTRY_DSN=
# Performance: 0 = apagado. Contra una instancia propia, cada transaccion ocupa
# disco en el VPS. Subir a 0.1 solo si estas investigando algo puntual.
SENTRY_TRACES_SAMPLE_RATE=0
# Profiling: GlitchTip no lo soporta. Dejar en 0.
SENTRY_PROFILES_SAMPLE_RATE=0

# Cloudflare R2 (material didactico). Sin estas vars el endpoint /api/material/upload-url
# responde 503 y no se puede subir material nuevo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ccdt-material
# URL publica del bucket: dominio propio o el de r2.dev. Sin barra final.
R2_PUBLIC_URL=
